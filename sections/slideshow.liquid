{%- if section.blocks.size > 0 -%}
  {%- if section.settings.height_desktop == 'adapt' or section.settings.height_desktop == 'adapt-each' or section.settings.height_mobile == 'adapt' or section.settings.height_mobile == 'adapt-each' -%}
    {%- assign first_block = section.blocks.first -%}
    <style>
      {%- if section.settings.height_desktop == 'adapt' -%}
        #Slideshow-{{ section.id }}.slideshow--desktop-adapt {
          height: auto;
        }
        #Slideshow-{{ section.id }}.slideshow--desktop-adapt .slideshow__inner {
          {%- if first_block.type == 'image' and first_block.settings.image != blank -%}
            aspect-ratio: {{ first_block.settings.image.aspect_ratio }};
          {%- elsif first_block.type == 'video' -%}
            aspect-ratio: {{ section.settings.desktop_video_width | default: '1920' }} / {{ section.settings.desktop_video_height | default: '800' }};
          {%- else -%}
            aspect-ratio: 16 / 9;
          {%- endif -%}
        }
      {%- elsif section.settings.height_desktop == 'adapt-each' -%}
        #Slideshow-{{ section.id }}.slideshow--desktop-adapt-each {
          height: auto;
        }
        #Slideshow-{{ section.id }}.slideshow--desktop-adapt-each .slideshow__inner {
          transition: aspect-ratio 0.5s ease-in-out;
        }
      {%- endif -%}

      {%- if section.settings.height_mobile == 'adapt' -%}
        @media (max-width: 768px) {
          #Slideshow-{{ section.id }}.slideshow--mobile-adapt {
            height: auto;
          }
          #Slideshow-{{ section.id }}.slideshow--mobile-adapt .slideshow__inner {
            {%- if first_block.type == 'image' -%}
              {%- if first_block.settings.mobile_image != blank -%}
                aspect-ratio: {{ first_block.settings.mobile_image.aspect_ratio }};
              {%- elsif first_block.settings.image != blank -%}
                aspect-ratio: {{ first_block.settings.image.aspect_ratio }};
              {%- else -%}
                aspect-ratio: 16 / 9;
              {%- endif -%}
            {%- elsif first_block.type == 'video' -%}
              {%- if first_block.settings.enable_mobile_video -%}
                aspect-ratio: {{ section.settings.mobile_video_width | default: '2000' }} / {{ section.settings.mobile_video_height | default: '2499' }};
              {%- else -%}
                aspect-ratio: {{ section.settings.desktop_video_width | default: '1920' }} / {{ section.settings.desktop_video_height | default: '800' }};
              {%- endif -%}
            {%- else -%}
              aspect-ratio: 16 / 9;
            {%- endif -%}
          }
        }
      {%- elsif section.settings.height_mobile == 'adapt-each' -%}
        @media (max-width: 768px) {
          #Slideshow-{{ section.id }}.slideshow--mobile-adapt-each {
            height: auto;
          }
          #Slideshow-{{ section.id }}.slideshow--mobile-adapt-each .slideshow__inner {
            transition: aspect-ratio 0.5s ease-in-out;
          }
        }
      {%- endif -%}
    </style>
  {%- endif -%}

  <div 
    id="Slideshow-{{ section.id }}" 
    class="slideshow slideshow--desktop-{{ section.settings.height_desktop }} slideshow--mobile-{{ section.settings.height_mobile }} slideshow--{{ section.settings.animation }} color-{{ section.settings.color_scheme }} gradient {% if section.settings.remove_padding_top %}slideshow--no-padding-top{% endif %} {% if section.settings.remove_padding_bottom %}slideshow--no-padding-bottom{% endif %} full-width"
    data-autoplay="{{ section.settings.autoplay }}"
    data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
    role="region"
    aria-roledescription="carousel"
    aria-label="Slideshow Hero Banner"
  >
    <div class="slideshow__inner">
      {%- for block in section.blocks -%}
        {%- assign desktop_aspect = '16/9' -%}
        {%- assign mobile_aspect = '16/9' -%}
        
        {%- if block.type == 'image' -%}
          {%- if block.settings.image != blank -%}
            {%- assign desktop_aspect = block.settings.image.aspect_ratio -%}
            {%- if block.settings.mobile_image != blank -%}
              {%- assign mobile_aspect = block.settings.mobile_image.aspect_ratio -%}
            {%- else -%}
              {%- assign mobile_aspect = block.settings.image.aspect_ratio -%}
            {%- endif -%}
          {%- endif -%}
        {%- elsif block.type == 'video' -%}
          {%- assign desktop_aspect = section.settings.desktop_video_width | default: '1920' | append: '/' | append: section.settings.desktop_video_height | default: '800' -%}
          {%- if block.settings.enable_mobile_video -%}
            {%- assign mobile_aspect = section.settings.mobile_video_width | default: '2000' | append: '/' | append: section.settings.mobile_video_height | default: '2499' -%}
          {%- else -%}
            {%- assign mobile_aspect = section.settings.desktop_video_width | default: '1920' | append: '/' | append: section.settings.desktop_video_height | default: '800' -%}
          {%- endif -%}
        {%- endif -%}

        <div 
          class="slideshow__slide{% if forloop.first %} is-active{% endif %}" 
          id="Slide-{{ block.id }}"
          data-index="{{ forloop.index0 }}"
          data-aspect-ratio-desktop="{{ desktop_aspect }}"
          data-aspect-ratio-mobile="{{ mobile_aspect }}"
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} of {{ section.blocks.size }}"
          {{ block.shopify_attributes }}
          style="
            --overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
            --slide-bg: {{ block.settings.slide_bg_color }};
            --image-fit: {{ block.settings.image_fit }};
          "
        >
          <div class="slideshow__image-container">
            {%- if block.type == 'video' -%}
              {%- comment -%} Determine if we have a poster image {%- endcomment -%}
              {%- assign poster_url = '' -%}
              {%- if block.settings.cover_image != blank -%}
                {%- assign poster_url = block.settings.cover_image | image_url: width: 2000 -%}
              {%- endif -%}

              {%- if block.settings.video_source == 'shopify-hosted' -%}
                {%- if block.settings.video != blank -%}
                  {%- if block.settings.enable_mobile_video and block.settings.mobile_video != blank -%}
                    {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, poster: poster_url, class: 'slideshow__image slideshow__video hide-on-mobile' }}
                    {{ block.settings.mobile_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, poster: poster_url, class: 'slideshow__image slideshow__video show-on-mobile' }}
                  {%- else -%}
                    {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, poster: poster_url, class: 'slideshow__image slideshow__video' }}
                  {%- endif -%}
                {%- else -%}
                  {%- if block.settings.cover_image != blank -%}
                    <img src="{{ block.settings.cover_image | image_url: width: 2200 }}" alt="{{ block.settings.cover_image.alt | escape }}" class="slideshow__image" loading="lazy" width="{{ block.settings.cover_image.width }}" height="{{ block.settings.cover_image.height }}">
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'slideshow__image slideshow__placeholder' }}
                  {%- endif -%}
                {%- endif -%}
              {%- else -%}
                {%- comment -%} External video URL {%- endcomment -%}
                {%- if block.settings.enable_mobile_video -%}
                  {%- comment -%} Desktop external video {%- endcomment -%}
                  <div class="slideshow__video-wrapper hide-on-mobile">
                    {%- if block.settings.video_url != blank -%}
                      {%- if block.settings.video_url.type == 'youtube' -%}
                        <iframe src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ block.settings.video_url.id }}&controls=0&showinfo=0&rel=0&modestbranding=1" class="slideshow__image slideshow__video" allow="autoplay; encrypted-media" frameborder="0"></iframe>
                      {%- elsif block.settings.video_url.type == 'vimeo' -%}
                        <iframe src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?autoplay=1&loop=1&autopause=0&muted=1&background=1" class="slideshow__image slideshow__video" allow="autoplay; encrypted-media" frameborder="0"></iframe>
                      {%- endif -%}
                    {%- elsif block.settings.cover_image != blank -%}
                      <img src="{{ block.settings.cover_image | image_url: width: 2200 }}" alt="{{ block.settings.cover_image.alt | escape }}" class="slideshow__image" loading="lazy" width="{{ block.settings.cover_image.width }}" height="{{ block.settings.cover_image.height }}">
                    {%- else -%}
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'slideshow__image slideshow__placeholder' }}
                    {%- endif -%}
                  </div>
                  {%- comment -%} Mobile external video {%- endcomment -%}
                  <div class="slideshow__video-wrapper show-on-mobile">
                    {%- if block.settings.mobile_video_source == 'shopify-hosted' and block.settings.mobile_video != blank -%}
                      {{ block.settings.mobile_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, poster: poster_url, class: 'slideshow__image slideshow__video' }}
                    {%- elsif block.settings.mobile_video_source == 'external' and block.settings.mobile_video_url != blank -%}
                      {%- if block.settings.mobile_video_url.type == 'youtube' -%}
                        <iframe src="https://www.youtube.com/embed/{{ block.settings.mobile_video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ block.settings.mobile_video_url.id }}&controls=0&showinfo=0&rel=0&modestbranding=1" class="slideshow__image slideshow__video" allow="autoplay; encrypted-media" frameborder="0"></iframe>
                      {%- elsif block.settings.mobile_video_url.type == 'vimeo' -%}
                        <iframe src="https://player.vimeo.com/video/{{ block.settings.mobile_video_url.id }}?autoplay=1&loop=1&autopause=0&muted=1&background=1" class="slideshow__image slideshow__video" allow="autoplay; encrypted-media" frameborder="0"></iframe>
                      {%- endif -%}
                    {%- elsif block.settings.video_url != blank -%}
                      {%- comment -%} Fallback to desktop external video {%- endcomment -%}
                      {%- if block.settings.video_url.type == 'youtube' -%}
                        <iframe src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ block.settings.video_url.id }}&controls=0&showinfo=0&rel=0&modestbranding=1" class="slideshow__image slideshow__video" allow="autoplay; encrypted-media" frameborder="0"></iframe>
                      {%- elsif block.settings.video_url.type == 'vimeo' -%}
                        <iframe src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?autoplay=1&loop=1&autopause=0&muted=1&background=1" class="slideshow__image slideshow__video" allow="autoplay; encrypted-media" frameborder="0"></iframe>
                      {%- endif -%}
                    {%- elsif block.settings.cover_image != blank -%}
                      <img src="{{ block.settings.cover_image | image_url: width: 2200 }}" alt="{{ block.settings.cover_image.alt | escape }}" class="slideshow__image" loading="lazy" width="{{ block.settings.cover_image.width }}" height="{{ block.settings.cover_image.height }}">
                    {%- else -%}
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'slideshow__image slideshow__placeholder' }}
                    {%- endif -%}
                  </div>
                {%- else -%}
                  {%- comment -%} Single external video {%- endcomment -%}
                  {%- if block.settings.video_url != blank -%}
                    {%- if block.settings.video_url.type == 'youtube' -%}
                      <iframe src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ block.settings.video_url.id }}&controls=0&showinfo=0&rel=0&modestbranding=1" class="slideshow__image slideshow__video" allow="autoplay; encrypted-media" frameborder="0"></iframe>
                    {%- elsif block.settings.video_url.type == 'vimeo' -%}
                      <iframe src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?autoplay=1&loop=1&autopause=0&muted=1&background=1" class="slideshow__image slideshow__video" allow="autoplay; encrypted-media" frameborder="0"></iframe>
                    {%- endif -%}
                  {%- elsif block.settings.cover_image != blank -%}
                    <img src="{{ block.settings.cover_image | image_url: width: 2200 }}" alt="{{ block.settings.cover_image.alt | escape }}" class="slideshow__image" loading="lazy" width="{{ block.settings.cover_image.width }}" height="{{ block.settings.cover_image.height }}">
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'slideshow__image slideshow__placeholder' }}
                  {%- endif -%}
                {%- endif -%}
              {%- endif -%}
            {%- else -%}
              {%- comment -%} Block is Image {%- endcomment -%}
              {%- if block.settings.image != blank -%}
                {%- if block.settings.mobile_image != blank -%}
                  <picture class="slideshow__image-picture">
                    <source media="(max-width: 768px)" srcset="{{ block.settings.mobile_image | image_url: width: 1000 }}">
                    <img 
                      src="{{ block.settings.image | image_url: width: 2200 }}" 
                      alt="{{ block.settings.image.alt | escape }}" 
                      class="slideshow__image" 
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                      width="2200"
                      height="auto"
                    >
                  </picture>
                {%- else -%}
                  <img 
                    src="{{ block.settings.image | image_url: width: 2200 }}" 
                    alt="{{ block.settings.image.alt | escape }}" 
                    class="slideshow__image" 
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    width="2200"
                    height="auto"
                  >
                {%- endif -%}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'slideshow__image slideshow__placeholder' }}
              {%- endif -%}
            {%- endif -%}
            
            <div class="slideshow__overlay" style="background-color: {{ block.settings.overlay_color }};"></div>
          </div>

          <div class="slideshow__content-container slideshow__content-container--{{ section.settings.content_position }}">
            <div class="slideshow__content">
              {%- if block.settings.subheading != blank -%}
                <div class="slideshow__subheading slideshow__animated" style="color: {{ block.settings.text_color }};">
                  {{ block.settings.subheading | remove: '<p>' | remove: '</p>' | remove: '<p >' }}
                </div>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <h2 class="slideshow__heading slideshow__animated" style="color: {{ block.settings.text_color }};">
                  {{ block.settings.heading }}
                </h2>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <div class="slideshow__description slideshow__animated" style="color: {{ block.settings.text_color }};">
                  {{ block.settings.description }}
                </div>
              {%- endif -%}

              {%- if block.settings.button_label != blank or block.settings.secondary_button_label != blank -%}
                <div class="slideshow__buttons slideshow__animated">
                  {%- if block.settings.button_label != blank -%}
                    <a 
                      href="{{ block.settings.button_link | default: '#' }}" 
                      class="button {% if block.settings.button_style == 'solid' %}button--primary{% else %}slideshow__button--link{% endif %} slideshow__button"
                      style="
                        --btn-bg: {{ block.settings.btn_background_color }};
                        --btn-text: {{ block.settings.btn_text_color }};
                        --btn-border: {{ block.settings.btn_border_color }};
                      "
                    >
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}

                  {%- if block.settings.secondary_button_label != blank -%}
                    <a 
                      href="{{ block.settings.secondary_button_link | default: '#' }}" 
                      class="button {% if block.settings.button_style == 'solid' %}button--secondary{% else %}slideshow__button--link{% endif %} slideshow__button"
                      style="
                        --btn-bg: transparent;
                        --btn-text: {{ block.settings.text_color }};
                        --btn-border: {{ block.settings.text_color }};
                      "
                    >
                      {{ block.settings.secondary_button_label | escape }}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      {%- if section.settings.show_navigation -%}
        <button type="button" class="slideshow__arrow slideshow__arrow--prev" aria-label="Previous slide">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
        </button>
      {%- endif -%}

      <div class="slideshow__controls">
        {%- if section.settings.show_pagination_number -%}
          <div class="slideshow__pagination-number">
            <span class="slideshow__pagination-current">01</span>
            <span class="slideshow__pagination-separator">/</span>
            <span class="slideshow__pagination-total">{{ section.blocks.size | prepend: '0' | slice: -2, 2 }}</span>
          </div>
        {%- else -%}
          <div class="slideshow__dots">
            {%- for block in section.blocks -%}
              <button type="button" class="slideshow__dot{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_navigation -%}
        <button type="button" class="slideshow__arrow slideshow__arrow--next" aria-label="Next slide">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      {%- endif -%}
    {%- endif -%}
  </div>

  <script>
    (function() {
      function initSlideshow() {
        const slideshow = document.getElementById('Slideshow-{{ section.id }}');
        if (!slideshow) return;

        const slides = slideshow.querySelectorAll('.slideshow__slide');
        const dots = slideshow.querySelectorAll('.slideshow__dot');
        const prevBtn = slideshow.querySelector('.slideshow__arrow--prev');
        const nextBtn = slideshow.querySelector('.slideshow__arrow--next');
        const isFade = slideshow.classList.contains('slideshow--fade');
        const slideInner = slideshow.querySelector('.slideshow__inner');
        
        if (slides.length <= 1) return;

        let currentIndex = 0;
        let autoplayTimer = null;
        const autoplay = slideshow.dataset.autoplay === 'true';
        const speed = parseInt(slideshow.dataset.speed) || 5000;

        function updateAspectRatio() {
          const isMobile = window.innerWidth <= 768;
          const activeSlide = slides[currentIndex];
          if (!activeSlide) return;

          const isAdaptEach = (slideshow.classList.contains('slideshow--desktop-adapt-each') && !isMobile) ||
                              (slideshow.classList.contains('slideshow--mobile-adapt-each') && isMobile);
          
          if (slideInner) {
            if (isAdaptEach) {
              const aspect = isMobile ? activeSlide.dataset.aspectRatioMobile : activeSlide.dataset.aspectRatioDesktop;
              if (aspect) {
                slideInner.style.aspectRatio = aspect;
              }
            } else {
              slideInner.style.removeProperty('aspect-ratio');
            }
          }
        }

        function showSlide(index) {
          slides[currentIndex].classList.remove('is-active');
          if (dots[currentIndex]) dots[currentIndex].classList.remove('is-active');

          currentIndex = (index + slides.length) % slides.length;

          slides[currentIndex].classList.add('is-active');
          if (dots[currentIndex]) dots[currentIndex].classList.add('is-active');

          // Update pagination numbers if active
          const currentSpan = slideshow.querySelector('.slideshow__pagination-current');
          if (currentSpan) {
            currentSpan.textContent = String(currentIndex + 1).padStart(2, '0');
          }

          updateAspectRatio();

          if (!isFade && slideInner) {
            slideInner.style.transform = `translateX(-${currentIndex * 100}%)`;
          }
        }

        function nextSlide() {
          showSlide(currentIndex + 1);
        }

        function prevSlide() {
          showSlide(currentIndex - 1);
        }

        function startAutoplay() {
          if (!autoplay) return;
          stopAutoplay();
          autoplayTimer = setInterval(nextSlide, speed);
        }

        function stopAutoplay() {
          if (autoplayTimer) {
            clearInterval(autoplayTimer);
            autoplayTimer = null;
          }
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', (e) => {
            e.preventDefault();
            nextSlide();
            startAutoplay();
          });
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', (e) => {
            e.preventDefault();
            prevSlide();
            startAutoplay();
          });
        }

        dots.forEach(dot => {
          dot.addEventListener('click', (e) => {
            e.preventDefault();
            const index = parseInt(e.target.dataset.index);
            showSlide(index);
            startAutoplay();
          });
        });

        slideshow.addEventListener('mouseenter', stopAutoplay);
        slideshow.addEventListener('mouseleave', startAutoplay);

        window.addEventListener('resize', updateAspectRatio);

        // Listen for brand switcher events
        window.addEventListener('brand:change', function(e) {
          if (!e.detail) return;
          const targetIndex = e.detail.index;
          const targetTitle = (e.detail.title || '').toLowerCase();
          const targetHandle = (e.detail.handle || '').toLowerCase();

          let matchedIndex = -1;
          slides.forEach((slide, idx) => {
            const heading = (slide.querySelector('.slideshow__heading')?.textContent || '').toLowerCase();
            if (heading) {
              if (heading.includes(targetTitle) || targetTitle.includes(heading.trim()) ||
                  (targetTitle.includes('pret') && heading.includes('pret')) ||
                  (targetTitle.includes('couture') && heading.includes('couture')) ||
                  (targetHandle.includes('pret') && heading.includes('pret')) ||
                  (targetHandle.includes('couture') && heading.includes('couture'))) {
                matchedIndex = idx;
              }
            }
          });

          if (matchedIndex !== -1) {
            showSlide(matchedIndex);
            startAutoplay();
          } else if (typeof targetIndex === 'number' && targetIndex >= 0 && targetIndex < slides.length) {
            showSlide(targetIndex);
            startAutoplay();
          }
        });

        // Sync initial slide with active brand if specified in URL or session
        (function() {
          const urlParams = new URLSearchParams(window.location.search);
          const initialBrand = (urlParams.get('brand') || (window.location.hash ? window.location.hash.replace('#', '') : '')).toLowerCase();
          if (initialBrand) {
            slides.forEach((slide, idx) => {
              const heading = (slide.querySelector('.slideshow__heading')?.textContent || '').toLowerCase();
              if (heading && ((initialBrand.includes('pret') && heading.includes('pret')) || (initialBrand.includes('couture') && heading.includes('couture')))) {
                showSlide(idx);
              }
            });
          }
        })();

        if (!isFade && slideInner) {
          slideInner.style.transform = `translateX(-${currentIndex * 100}%)`;
        }

        updateAspectRatio();
        startAutoplay();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSlideshow);
      } else {
        initSlideshow();
      }

      document.addEventListener('shopify:section:load', function(e) {
        if (e.target.id === 'shopify-section-{{ section.id }}') {
          initSlideshow();
        }
      });
    })();
  </script>
{%- endif -%}



{% schema %}
{
  "name": "Slideshow",
  "class": "slideshow-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-4"
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "Section height on large screen",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to first media"
        },
        {
          "value": "adapt-each",
          "label": "Adapt to each media (Original size)"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
