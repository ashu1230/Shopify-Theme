<footer class="color-{{ section.settings.color_scheme }} gradient footer-section full-width">
  <div class="footer__inner page-width">

    {%- for block in section.blocks -%}

      {%- case block.type -%}

        {%- when 'image' -%}
          <div class="footer__block footer__block--image" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <a href="{{ block.settings.image_link | default: routes.root_url }}">
                {{
                  block.settings.image
                  | image_url: width: 300
                  | image_tag:
                    loading: 'lazy',
                    width: block.settings.image_width,
                    class: 'footer__image'
                }}
              </a>
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'footer__image footer__image--placeholder' }}
            {%- endif -%}
          </div>

        {%- when 'text' -%}
          <div class="footer__block footer__block--text" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="footer__heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="footer__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>

        {%- when 'links' -%}
          <div class="footer__block footer__block--links" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="footer__heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="footer__link-list list-unstyled">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="footer__link">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>

        {%- when 'newsletter' -%}
          <div class="footer__block footer__block--newsletter" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="footer__heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.subtext != blank -%}
              <p class="footer__newsletter-subtext">{{ block.settings.subtext }}</p>
            {%- endif -%}
            {%- form 'customer', id: 'footer-newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="footer__newsletter-form">
                <input
                  type="email"
                  name="contact[email]"
                  id="footer-newsletter-email"
                  class="footer__newsletter-input"
                  placeholder="{{ block.settings.placeholder | default: 'Enter your email' }}"
                  aria-label="{{ block.settings.placeholder | default: 'Enter your email' }}"
                  required
                >
                <button type="submit" class="footer__newsletter-btn button button--primary">
                  {{ block.settings.button_label | default: 'Subscribe' }}
                </button>
              </div>
              {%- if form.posted_successfully? -%}
                <p class="footer__newsletter-success">{{ 'general.newsletter.success' | t }}</p>
              {%- endif -%}
            {%- endform -%}
          </div>

      {%- endcase -%}
    {%- endfor -%}

  </div>

  <div class="footer__bottom page-width">
    <div class="footer__copyright">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}
      {{ powered_by_link }}
    </div>

    {%- if section.settings.show_payment_icons -%}
      <div class="footer__payment">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag }}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer__social-wrap">
      {% render 'social-icons' %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "image_link",
          "label": "Image link"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 50,
          "max": 300,
          "step": 10,
          "unit": "px",
          "label": "Image width",
          "default": 160
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About us"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share a little about your brand or store here.</p>"
        }
      ]
    },
    {
      "type": "links",
      "name": "Links",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Newsletter"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Subscribe to get special offers and updates."
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Email placeholder",
          "default": "Enter your email"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Subscribe"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "image" },
        { "type": "text" },
        { "type": "links" },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
