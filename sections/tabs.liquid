<div
  id="Tabs-{{ section.id }}"
  class="tabs-section color-{{ section.settings.color_scheme }} gradient full-width {% if section.settings.remove_padding_top %}section--no-padding-top{% endif %} {% if section.settings.remove_padding_bottom %}section--no-padding-bottom{% endif %}"
  {{ section.shopify_attributes }}
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="tabs__header tabs__header--align-{{ section.settings.header_alignment | default: 'center' }}">
        {%- if section.settings.subheading != blank -%}
          <span class="tabs__subheading">{{ section.settings.subheading | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="tabs__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="tabs__wrapper tabs__wrapper--width-{{ section.settings.content_width | default: 'medium' }}">
        {%- comment -%} Tab Buttons Bar {%- endcomment -%}
        <div
          class="tabs__nav tabs__nav--style-{{ section.settings.tab_style | default: 'underline' }} tabs__nav--align-{{ section.settings.header_alignment | default: 'center' }}"
          role="tablist"
          aria-label="{{ section.settings.heading | default: 'Tabs' | escape }}"
        >
          {%- for block in section.blocks -%}
            <button
              type="button"
              role="tab"
              class="tabs__btn{% if forloop.first %} is-active{% endif %}"
              id="tab-btn-{{ section.id }}-{{ block.id }}"
              data-tab-target="tab-panel-{{ section.id }}-{{ block.id }}"
              aria-controls="tab-panel-{{ section.id }}-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.title | default: 'Tab ' | append: forloop.index | escape }}
            </button>
          {%- endfor -%}
        </div>

        {%- comment -%} Tab Content Panels {%- endcomment -%}
        <div class="tabs__panels">
          {%- for block in section.blocks -%}
            <div
              id="tab-panel-{{ section.id }}-{{ block.id }}"
              class="tabs__panel{% if forloop.first %} is-active{% endif %}"
              role="tabpanel"
              aria-labelledby="tab-btn-{{ section.id }}-{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              <div class="tabs__panel-inner{% if block.settings.image != blank %} tabs__panel-inner--with-media{% endif %}">
                <div class="tabs__panel-text">
                  {%- if block.settings.content != blank -%}
                    <div class="rte">
                      {{ block.settings.content }}
                    </div>
                  {%- elsif block.settings.page != blank -%}
                    <div class="rte">
                      {{ block.settings.page.content }}
                    </div>
                  {%- else -%}
                    <div class="rte">
                      <p>Add rich text or connect a page to display content inside this tab panel.</p>
                    </div>
                  {%- endif -%}
                </div>

                {%- if block.settings.image != blank -%}
                  <div class="tabs__panel-media">
                    {{
                      block.settings.image
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        class: 'tabs__panel-image',
                        widths: '375, 550, 750'
                    }}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Tabs",
  "class": "tabs-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Details"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product details & care"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "tab_style",
      "label": "Tab style",
      "options": [
        { "value": "underline", "label": "Minimal underline" },
        { "value": "boxed", "label": "Bordered box" },
        { "value": "pills", "label": "Rounded pills" }
      ],
      "default": "underline"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        { "value": "narrow", "label": "Narrow (750px)" },
        { "value": "medium", "label": "Medium (950px)" },
        { "value": "wide", "label": "Wide (1200px)" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "checkbox",
      "id": "remove_padding_top",
      "default": false,
      "label": "Remove top padding"
    },
    {
      "type": "checkbox",
      "id": "remove_padding_bottom",
      "default": false,
      "label": "Remove bottom padding"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab title",
          "default": "Description"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Tab content",
          "default": "<p>Share detailed information about your materials, manufacturing process, fit specifications, or product care guidelines here.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Content from page",
          "info": "Optionally load content from an existing Shopify page"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Side image (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabs",
      "category": "Content",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "title": "Materials & Fabric",
            "content": "<p>Crafted from 100% sustainably sourced organic Egyptian cotton, woven to a soft 350-thread count sateen finish for optimal breathability and luxury comfort.</p>"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Care Instructions",
            "content": "<p>Machine wash cold on gentle cycle with similar colors. Line dry in shade or tumble dry low. Do not bleach. Cool iron if necessary.</p>"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Shipping & Returns",
            "content": "<p>We offer complimentary carbon-neutral worldwide shipping on all orders. Returns and exchanges are accepted within 30 days of delivery in original condition.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

