{%- assign current_brand = 'couture' -%}
{%- if template.suffix contains 'pret' or request.path contains 'pret' -%}
  {%- assign current_brand = 'pret' -%}
{%- endif -%}

{%- assign show_section = true -%}
{%- if section.settings.brand_visibility == 'couture' and current_brand == 'pret' -%}
  {%- assign show_section = false -%}
{%- elsif section.settings.brand_visibility == 'pret' and current_brand != 'pret' -%}
  {%- assign show_section = false -%}
{%- endif -%}

{%- assign active_scheme = section.settings.color_scheme -%}
{%- if current_brand == 'pret' and section.settings.pret_color_scheme != blank -%}
  {%- assign active_scheme = section.settings.pret_color_scheme -%}
{%- endif -%}

{%- if section.blocks.size > 0 -%}
  <div
    id="announcement-bar-{{ section.id }}"
    class="announcement-bar full-width color-{{ active_scheme }} gradient"
    data-brand-visibility="{{ section.settings.brand_visibility | default: 'all' }}"
    data-couture-scheme="{{ section.settings.color_scheme }}"
    data-pret-scheme="{{ section.settings.pret_color_scheme | default: section.settings.color_scheme }}"
    {% unless show_section %}style="display:none;"{% endunless %}
    role="region"
    aria-label="{{ 'announcement_bar.title' | t }}"
  >
    <div class="announcement-bar__inner">
      {%- if section.blocks.size > 1 and section.settings.auto_rotate -%}
        {%- comment -%} Multiple announcements with auto-rotate {%- endcomment -%}
        <div class="announcement-bar__slider" data-auto-rotate data-speed="{{ section.settings.rotate_speed }}">
          {%- for block in section.blocks -%}
            {%- assign block_brand = block.settings.brand_target | default: 'all' -%}
            <div
              class="announcement-bar__message{% if forloop.first %} is-active{% endif %}"
              {{ block.shopify_attributes }}
              data-brand-target="{{ block_brand }}"
              role="group"
              aria-roledescription="slide"
              aria-label="{{ forloop.index }} / {{ section.blocks.size }}"
            >
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="announcement-bar__link">
                  {{ block.settings.text }}
                </a>
              {%- else -%}
                <p class="announcement-bar__text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        {%- comment -%} Single announcement or no rotation {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- assign block_brand = block.settings.brand_target | default: 'all' -%}
          <div class="announcement-bar__message is-active" {{ block.shopify_attributes }} data-brand-target="{{ block_brand }}">
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="announcement-bar__link">
                {{ block.settings.text }}
              </a>
            {%- else -%}
              <p class="announcement-bar__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .announcement-bar {
    position: relative;
    z-index: 10;
    overflow: hidden;
  }

  .announcement-bar__link {
    color: inherit;
    text-decoration: underline;
  }

  .announcement-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    position: relative;
  }

  .announcement-bar__slider {
    position: relative;
    width: 100%;
    text-align: center;
    overflow: hidden;
    min-height: 1.5em;
  }

  .announcement-bar__message {
    text-align: center;
    width: 100%;
  }

  .announcement-bar__slider .announcement-bar__message {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    opacity: 0;
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
  }

  .announcement-bar__slider .announcement-bar__message.is-active {
    position: relative;
    top: auto;
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .announcement-bar__text,
  .announcement-bar__link {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.4;
    margin: 0;
  }

  .announcement-bar__link {
    color: var(--announcement-link, #ffffff);
    text-decoration: none;
    display: inline-block;
    position: relative;
  }

  .announcement-bar__link::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    opacity: 0.4;
    transition: opacity 0.3s ease;
  }

  .announcement-bar__link:hover::after {
    opacity: 1;
  }

  /* Brand visibility rules */
  html[data-active-brand="pret"] [data-brand-visibility="couture"] { display: none !important; }
  html[data-active-brand="couture"] [data-brand-visibility="pret"] { display: none !important; }
  html[data-active-brand="pret"] .announcement-bar__message[data-brand-target="couture"] { display: none !important; }
  html[data-active-brand="couture"] .announcement-bar__message[data-brand-target="pret"] { display: none !important; }
{% endstylesheet %}

{% javascript %}
  /* Auto-rotate slider with brand awareness */
  (function() {
    function initAnnouncementSlider() {
      const slider = document.querySelector('[data-auto-rotate]');
      if (!slider) return;

      const currentBrand = document.documentElement.getAttribute('data-active-brand') || (window.location.search.includes('pret') || window.location.pathname.includes('pret') ? 'pret' : 'couture');

      const allMessages = slider.querySelectorAll('.announcement-bar__message');
      const messages = Array.from(allMessages).filter(msg => {
        const target = msg.getAttribute('data-brand-target') || 'all';
        return target === 'all' || target === currentBrand;
      });

      if (messages.length === 0) return;

      allMessages.forEach(m => m.classList.remove('is-active'));
      messages[0].classList.add('is-active');

      if (messages.length <= 1) return;

      const speed = parseInt(slider.dataset.speed, 10) || 5;
      let currentIndex = 0;

      if (slider._interval) clearInterval(slider._interval);
      slider._interval = setInterval(function() {
        messages[currentIndex].classList.remove('is-active');
        currentIndex = (currentIndex + 1) % messages.length;
        messages[currentIndex].classList.add('is-active');
      }, speed * 1000);
    }

    initAnnouncementSlider();
    window.addEventListener('theme:brand:change', initAnnouncementSlider);
    document.addEventListener('shopify:section:load', initAnnouncementSlider);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.announcement_bar",
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "brand_visibility",
      "label": "t:labels.brand_visibility",
      "options": [
        { "value": "all", "label": "t:options.brand_all" },
        { "value": "couture", "label": "t:options.brand_couture" },
        { "value": "pret", "label": "t:options.brand_pret" }
      ],
      "default": "all"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-4"
    },
    {
      "type": "color_scheme",
      "id": "pret_color_scheme",
      "label": "t:labels.pret_announcement_color_scheme",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:labels.auto_rotate",
      "default": true
    },
    {
      "type": "range",
      "id": "rotate_speed",
      "label": "t:labels.rotate_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:general.announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text",
          "default": "Welcome to our store"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        },
        {
          "type": "select",
          "id": "brand_target",
          "label": "t:labels.brand_target",
          "options": [
            { "value": "all", "label": "t:options.brand_all" },
            { "value": "couture", "label": "t:options.brand_couture" },
            { "value": "pret", "label": "t:options.brand_pret" }
          ],
          "default": "all"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.announcement_bar",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
