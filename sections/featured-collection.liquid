<div id="FeaturedCollections-{{ section.id }}" class="featured-collection section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient full-width {% if section.settings.remove_padding_top %}featured-collection--no-padding-top{% endif %} {% if section.settings.remove_padding_bottom %}featured-collection--no-padding-bottom{% endif %}">
  <div class="page-width">
    {%- if section.settings.title != blank or section.settings.subtitle != blank or section.blocks.size > 0 -%}
      <div class="featured-collection__header">
        {%- if section.settings.subtitle != blank -%}
          <span class="featured-collection__subtitle">{{ section.settings.subtitle | escape }}</span>
        {%- endif -%}

        {%- if section.blocks.size > 1 -%}
          {%- comment -%} Prestige Style: Collection Tab Switcher {%- endcomment -%}
          <div class="featured-collection__tabs" role="tablist">
            {%- for block in section.blocks -%}
              {%- assign tab_collection = collections[block.settings.collection] -%}
              {%- assign tab_title = block.settings.title | default: tab_collection.title | default: 'Collection' -%}
              <button
                type="button"
                role="tab"
                class="featured-collection__tab-btn{% if forloop.first %} is-active{% endif %}"
                data-tab-target="tab-panel-{{ section.id }}-{{ block.id }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{ tab_title | escape }}
              </button>
            {%- endfor -%}
          </div>
        {%- elsif section.blocks.size == 1 -%}
          {%- assign single_block = section.blocks.first -%}
          {%- assign single_coll = collections[single_block.settings.collection] -%}
          {%- assign single_title = single_block.settings.title | default: section.settings.title | default: single_coll.title -%}
          {%- if single_title != blank -%}
            <h2 class="featured-collection__title">{{ single_title | escape }}</h2>
          {%- endif -%}
        {%- elsif section.settings.title != blank -%}
          <h2 class="featured-collection__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Collections Carousel Panes {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- assign collection = collections[block.settings.collection] -%}
      {%- assign products_limit = block.settings.products_to_show | default: 8 -%}
      <div
        id="tab-panel-{{ section.id }}-{{ block.id }}"
        class="featured-collection__tab-panel{% if forloop.first %} is-active{% endif %}"
        role="tabpanel"
        {{ block.shopify_attributes }}
      >
        <div class="featured-collection__carousel-wrapper">
          {%- if section.settings.show_navigation -%}
            <button type="button" class="featured-collection__arrow featured-collection__arrow--prev" aria-label="Previous products" disabled>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
          {%- endif -%}

          <div class="featured-collection__grid" id="CollectionGrid-{{ section.id }}-{{ block.id }}">
            {%- if collection != blank and collection.products.size > 0 -%}
              {%- for product in collection.products limit: products_limit -%}
                {% render 'product-card', product: product %}
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..4) -%}
                {% render 'product-card', product: blank %}
              {%- endfor -%}
            {%- endif -%}
          </div>

          {%- if section.settings.show_navigation -%}
            <button type="button" class="featured-collection__arrow featured-collection__arrow--next" aria-label="Next products">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          {%- endif -%}
        </div>

        {%- if block.settings.button_text != blank or section.settings.show_view_all -%}
          {%- assign btn_link = block.settings.button_link | default: collection.url | default: '/collections/all' -%}
          {%- assign btn_text = block.settings.button_text | default: 'View all products' -%}
          <div class="featured-collection__view-all">
            <a href="{{ btn_link }}" class="button button--secondary featured-collection__view-all-btn">
              {{ btn_text | escape }}
            </a>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured collections",
  "class": "featured-collection-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Collection"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "DOHR COUTURE"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "remove_padding_top",
      "label": "Remove padding top",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "remove_padding_bottom",
      "label": "Remove padding bottom",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "info": "If left empty, the collection name is used."
        },
        {
          "type": "range",
          "id": "products_to_show",
          "min": 4,
          "max": 24,
          "step": 1,
          "label": "Products to show",
          "default": 8
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "View all products"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link",
          "info": "If left empty, collection URL is used."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured collections",
      "settings": {
        "title": "Featured Collection",
        "subtitle": "DOHR COUTURE"
      },
      "blocks": [
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
