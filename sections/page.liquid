{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<div class="page-section-wrapper section-width--{{ section.settings.section_width | default: 'page-width' }}">
<h1>{{ page.title }}</h1>

{{ page.content }}
</div>

{% schema %}
{
  "name": "t:general.page",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "full-width",
          "label": "Full width"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "page-width",
          "label": "Page content"
        }
      ],
      "default": "page-width"
    }
  ]
}
{% endschema %}
