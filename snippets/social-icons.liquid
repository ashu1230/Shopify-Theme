{%- comment -%}
  snippets/social-icons.liquid
  =============================
  Renders social media icons using settings.social_*_link values.
  Include anywhere with: {% render 'social-icons' %}
  Optional param: icon_size (default 20)
{%- endcomment -%}

{%- liquid
  assign icon_size = icon_size | default: 20
  assign has_social = false
  if settings.social_facebook_link  != blank or settings.social_twitter_link   != blank
    assign has_social = true
  endif
  if settings.social_pinterest_link != blank or settings.social_instagram_link != blank
    assign has_social = true
  endif
  if settings.social_youtube_link   != blank or settings.social_tiktok_link    != blank
    assign has_social = true
  endif
  if settings.social_threads_link   != blank or settings.social_vimeo_link     != blank
    assign has_social = true
  endif
  if settings.social_whatsapp_link  != blank or settings.social_tumblr_link    != blank
    assign has_social = true
  endif
  if settings.social_snapchat_link  != blank or settings.social_linkedin_link  != blank
    assign has_social = true
  endif
-%}

{%- if has_social -%}
<ul class="social-icons list-unstyled" aria-label="Social media links">

  {%- if settings.social_facebook_link != blank -%}
    <li class="social-icons__item">
      <a href="{{ settings.social_facebook_link }}" class="social-icons__link" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
        <svg width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
        </svg>
      </a>
    </li>
  {%- endif -%}

  {%- if settings.social_twitter_link != blank -%}
