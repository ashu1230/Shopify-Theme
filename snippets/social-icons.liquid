      <a href="{{ settings.social_twitter_link }}" class="social-icons__link" target="_blank" rel="noopener noreferrer" aria-label="X (formerly Twitter)">
        <svg width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
