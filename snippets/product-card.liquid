{%- comment -%}
  Universal Product Card Snippet
  ================================
  Reads all appearance from Theme Settings → Product card.
  Supports both real products and placeholder rendering.

  Usage:
    {% render 'product-card', product: product %}
    {% render 'product-card', product: product, lazy: false %}

  Variables read from settings:
    settings.product_card_image_size          → natural | square | portrait | landscape
    settings.product_card_secondary_image     → true | false
    settings.product_card_show_vendor         → true | false
    settings.product_card_title_max_lines     → 0–6  (0 = no truncation)
    settings.product_card_text_font           → heading | body_text
    settings.product_card_text_casing         → inherit | uppercase | lowercase | capitalize
    settings.product_card_price_varies        → show_min | show_range
    settings.product_card_color_display       → hide | swatches | text | count
    settings.product_card_show_rating         → true | false
    settings.product_card_show_no_reviews     → true | false
    settings.product_card_rating_display      → average | count | both
    settings.swatch_round                     → true | false  (from Color swatch group)
    settings.animation_image_zoom_hover       → true | false  (from Animation group)
{%- endcomment -%}

{%- liquid
  assign is_placeholder = false
  if product == blank
    assign is_placeholder = true
  endif

  assign img_size   = settings.product_card_image_size   | default: 'portrait'
  assign show_hover = settings.product_card_secondary_image
  assign show_vendor = settings.product_card_show_vendor
  assign max_lines  = settings.product_card_title_max_lines | default: 0
  assign text_font  = settings.product_card_text_font    | default: 'heading'
  assign text_casing = settings.product_card_text_casing | default: 'inherit'
  assign price_mode = settings.product_card_price_varies | default: 'show_min'
  assign color_mode = settings.product_card_color_display | default: 'hide'
  assign show_rating = settings.product_card_show_rating
  assign show_no_reviews = settings.product_card_show_no_reviews
  assign rating_display = settings.product_card_rating_display | default: 'average'
  assign round_swatches = settings.swatch_round
  assign zoom_hover = settings.animation_image_zoom_hover

  assign card_classes = 'product-card'
  if zoom_hover
    assign card_classes = card_classes | append: ' product-card--zoom-hover'
  endif
-%}

<div class="{{ card_classes }}">

  {%- comment -%}── IMAGE CONTAINER ──{%- endcomment -%}
  <div class="product-card__image-container product-card__image-container--{{ img_size }}">

    {%- unless is_placeholder -%}
      {%- comment -%} Badges {%- endcomment -%}
      <div class="product-card__badges">
        {%- if product.compare_at_price > product.price -%}
          {%- assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
          <span class="badge badge--save">SAVE {{ savings }}%</span>
        {%- endif -%}
        {%- for tag in product.tags -%}
          {%- assign tag_lower = tag | downcase -%}
          {%- if tag_lower == 'just-launched' or tag_lower == 'new' -%}
            <span class="badge badge--new">JUST LAUNCHED</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endunless -%}

    {%- if is_placeholder -%}
      {{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__placeholder' }}
    {%- else -%}
      <a href="{{ product.url }}" class="product-card__image-link" aria-label="{{ product.title | escape }}">

        {%- comment -%} Primary image {%- endcomment -%}
        {%- if product.featured_media != blank -%}
          <img
            src="{{ product.featured_media | image_url: width: 800 }}"
            alt="{{ product.featured_media.alt | escape }}"
            class="product-card__image product-card__image--primary"
            loading="{{ lazy | default: 'lazy' }}"
            width="{{ product.featured_media.width }}"
            height="{{ product.featured_media.height }}"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__placeholder' }}
        {%- endif -%}

        {%- comment -%} Secondary image on hover {%- endcomment -%}
        {%- if show_hover and product.media.size > 1 -%}
          {%- assign second_media = product.media[1] -%}
          <img
            src="{{ second_media | image_url: width: 800 }}"
            alt="{{ second_media.alt | escape }}"
            class="product-card__image product-card__image--secondary"
            loading="lazy"
            width="{{ second_media.width }}"
            height="{{ second_media.height }}"
          >
        {%- endif -%}
      </a>

      {%- comment -%} Size options overlay {%- endcomment -%}
      {%- for option in product.options_with_values -%}
        {%- assign opt_name = option.name | downcase -%}
        {%- if opt_name == 'size' or opt_name == 'sizes' -%}
          <div class="product-card__sizes">
            {%- for value in option.values -%}
              <span class="product-card__size-item">{{ value | escape }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Quick Add button {%- endcomment -%}
      {%- if product.available -%}
        <button
          type="button"
          class="product-card__quick-add"
          data-variant-id="{{ product.first_available_variant.id }}"
          aria-label="Add {{ product.title | escape }} to cart"
        >
          <svg class="product-card__bag-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <svg class="product-card__loading-icon hide" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="2" x2="12" y2="6"></line><line x1="12" y1="18" x2="12" y2="22"></line>
            <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line>
            <line x1="2" y1="12" x2="6" y2="12"></line><line x1="18" y1="12" x2="22" y2="12"></line>
            <line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line>
          </svg>
        </button>
      {%- endif -%}
    {%- endif -%}

  </div><!-- /.product-card__image-container -->

  {%- comment -%}── CARD INFO ──{%- endcomment -%}
  <div class="product-card__info product-card__info--font-{{ text_font }} product-card__info--casing-{{ text_casing }}">

    {%- if is_placeholder -%}
      <div class="product-card__fabric-container">
        <span class="product-card__fabric">FABRIC</span>
      </div>
      <h3 class="product-card__title"><a href="#">Example Product</a></h3>
      <div class="product-card__meta-row">
        <div class="product-card__price"><span class="price-current">Rs. 8,900.00</span></div>
      </div>
    {%- else -%}

      {%- comment -%} Vendor / type tag {%- endcomment -%}
      {%- if show_vendor -%}
        <div class="product-card__fabric-container">
          <span class="product-card__fabric">
            {%- if product.type != blank -%}{{ product.type | upcase }}{%- else -%}{{ product.vendor | upcase }}{%- endif -%}
          </span>
        </div>
      {%- endif -%}

      {%- comment -%} Title {%- endcomment -%}
      <h3 class="product-card__title{% if max_lines > 0 %} product-card__title--clamp{% endif %}"
          {% if max_lines > 0 %}style="-webkit-line-clamp: {{ max_lines }};"{% endif %}>
        <a href="{{ product.url }}">{{ product.title }}</a>
      </h3>

      {%- comment -%} Price row + color display {%- endcomment -%}
      <div class="product-card__meta-row">
        <div class="product-card__price">
          {%- if product.price_varies -%}
            {%- if price_mode == 'show_range' -%}
              <span class="price-current">{{ product.price_min | money }} – {{ product.price_max | money }}</span>
            {%- else -%}
              <span class="price-prefix">FROM </span>
              <span class="price-current">{{ product.price_min | money }}</span>
            {%- endif -%}
          {%- else -%}
            <span class="price-current">{{ product.price | money }}</span>
          {%- endif -%}
          {%- if product.compare_at_price > product.price -%}
            <span class="price-original">{{ product.compare_at_price | money }}</span>
          {%- endif -%}
        </div>

        {%- comment -%} Color display — swatches / text / count / hide {%- endcomment -%}
        {%- unless color_mode == 'hide' -%}
          {%- for option in product.options_with_values -%}
            {%- assign opt_name = option.name | downcase -%}
            {%- if opt_name == 'color' or opt_name == 'colour' -%}
              {%- if color_mode == 'swatches' -%}
                <div class="product-card__swatches{% if round_swatches %} product-card__swatches--round{% endif %}">
                  {%- for value in option.values limit: 4 -%}
                    {%- assign color_slug = value | downcase -%}
                    {%- assign color_bg   = color_slug -%}
                    {%- if color_slug contains 'blue'   %}{%- assign color_bg = '#7093c8' -%}
                    {%- elsif color_slug contains 'ivory'  %}{%- assign color_bg = '#f9f6e6' -%}
                    {%- elsif color_slug contains 'red'    %}{%- assign color_bg = '#d03d3d' -%}
                    {%- elsif color_slug contains 'pink'   %}{%- assign color_bg = '#f2a6b2' -%}
                    {%- elsif color_slug contains 'green'  %}{%- assign color_bg = '#8cae8b' -%}
                    {%- elsif color_slug contains 'yellow' %}{%- assign color_bg = '#f2d379' -%}
                    {%- elsif color_slug contains 'black'  %}{%- assign color_bg = '#1a1a1a' -%}
                    {%- elsif color_slug contains 'white'  %}{%- assign color_bg = '#ffffff' -%}
                    {%- endif -%}
                    <span class="product-card__swatch" style="background-color:{{ color_bg }};" title="{{ value | escape }}"></span>
                  {%- endfor -%}
                  {%- if option.values.size > 4 -%}
                    <span class="product-card__swatch-more">+{{ option.values.size | minus: 4 }}</span>
                  {%- endif -%}
                </div>
              {%- elsif color_mode == 'text' -%}
                <div class="product-card__color-text">
                  {{ option.values | join: ' / ' }}
                </div>
              {%- elsif color_mode == 'count' -%}
                <div class="product-card__color-count">
                  {{ option.values.size }} {% if option.values.size == 1 %}color{% else %}colors{% endif %}
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endunless -%}
      </div><!-- /.product-card__meta-row -->

      {%- comment -%} Star rating (reads metafield set by rating apps) {%- endcomment -%}
      {%- if show_rating -%}
        {%- assign rating_value = product.metafields.reviews.rating.value -%}
        {%- assign rating_count = product.metafields.reviews.rating_count.value | plus: 0 -%}
        {%- if rating_value != blank or show_no_reviews -%}
          <div class="product-card__rating">
            {%- if rating_value != blank -%}
              <span class="product-card__rating-stars" aria-hidden="true">★</span>
              {%- if rating_display == 'average' or rating_display == 'both' -%}
                <span class="product-card__rating-avg">{{ rating_value }}</span>
              {%- endif -%}
              {%- if rating_display == 'count' or rating_display == 'both' -%}
                <span class="product-card__rating-count">({{ rating_count }})</span>
              {%- endif -%}
            {%- else -%}
              <span class="product-card__rating-empty">No reviews yet</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}

    {%- endif -%}
  </div><!-- /.product-card__info -->

</div><!-- /.product-card -->

