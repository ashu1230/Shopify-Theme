{% style %}
  {% # Loads all font variations with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  {{ settings.type_secondary_font | font_face: font_display: 'swap' }}
  {{ settings.type_secondary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}

  :root {
    /* Fonts */
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --font-secondary--family: {{ settings.type_secondary_font.family }}, {{ settings.type_secondary_font.fallback_families }};
    --font-secondary--style: {{ settings.type_secondary_font.style }};
    --font-secondary--weight: {{ settings.type_secondary_font.weight }};

    /* Layout */
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;

    /* Product colors (global, not per-scheme) */
    --color-star-rating: {{ settings.color_star_rating }};
    --color-on-sale: {{ settings.color_on_sale }};
    --color-sold-out: {{ settings.color_sold_out }};
    --color-custom-badge: {{ settings.color_custom_badge }};

    /* Notification colors (global, not per-scheme) */
    --color-success: {{ settings.color_success }};
    --color-warning: {{ settings.color_warning }};
    --color-error: {{ settings.color_error }};

    /* Form styles */
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --style-border-radius-buttons: {{ settings.button_corner_radius }}px;
  }

  {% # Output a CSS class for every color scheme so sections can use them %}
  {% for scheme in settings.color_schemes %}
    .color-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background.red }}, {{ scheme.settings.background.green }}, {{ scheme.settings.background.blue }};
      --color-background-hex: {{ scheme.settings.background }};
      --color-background-gradient: {% if scheme.settings.background_gradient != blank %}{{ scheme.settings.background_gradient }}{% else %}{{ scheme.settings.background }}{% endif %};
      --color-text: {{ scheme.settings.text.red }}, {{ scheme.settings.text.green }}, {{ scheme.settings.text.blue }};
      --color-text-hex: {{ scheme.settings.text }};
      --color-button: {{ scheme.settings.button.red }}, {{ scheme.settings.button.green }}, {{ scheme.settings.button.blue }};
      --color-button-hex: {{ scheme.settings.button }};
      --color-button-label: {{ scheme.settings.button_label.red }}, {{ scheme.settings.button_label.green }}, {{ scheme.settings.button_label.blue }};
      --color-button-label-hex: {{ scheme.settings.button_label }};
      --color-secondary-button-label: {{ scheme.settings.secondary_button_label.red }}, {{ scheme.settings.secondary_button_label.green }}, {{ scheme.settings.secondary_button_label.blue }};
      --color-secondary-button-label-hex: {{ scheme.settings.secondary_button_label }};
      --color-shadow: {{ scheme.settings.shadow.red }}, {{ scheme.settings.shadow.green }}, {{ scheme.settings.shadow.blue }};

      /* Backward-compatible aliases */
      --color-foreground: rgb({{ scheme.settings.text.red }}, {{ scheme.settings.text.green }}, {{ scheme.settings.text.blue }});
      --color-accent-1: {{ scheme.settings.button }};
      --color-solid-button-label: {{ scheme.settings.button_label }};
      /* Direct color application */
      color: rgb(var(--color-text));
      background-color: rgb(var(--color-background));
    }

    .color-{{ scheme.id }}.gradient {
      background: {% if scheme.settings.background_gradient != blank %}{{ scheme.settings.background_gradient }}{% else %}rgb(var(--color-background)){% endif %};
    }
  {% endfor %}

  {% # Apply the default scheme to :root so un-schemed elements inherit it %}
  {% assign default_scheme = settings.color_schemes | where: 'id', settings.default_color_scheme | first %}
  {% if default_scheme %}
    :root {
      --color-background: {{ default_scheme.settings.background.red }}, {{ default_scheme.settings.background.green }}, {{ default_scheme.settings.background.blue }};
      --color-background-hex: {{ default_scheme.settings.background }};
      --color-background-gradient: {% if default_scheme.settings.background_gradient != blank %}{{ default_scheme.settings.background_gradient }}{% else %}{{ default_scheme.settings.background }}{% endif %};
      --color-text: {{ default_scheme.settings.text.red }}, {{ default_scheme.settings.text.green }}, {{ default_scheme.settings.text.blue }};
      --color-text-hex: {{ default_scheme.settings.text }};
      --color-button: {{ default_scheme.settings.button.red }}, {{ default_scheme.settings.button.green }}, {{ default_scheme.settings.button.blue }};
      --color-button-hex: {{ default_scheme.settings.button }};
      --color-button-label: {{ default_scheme.settings.button_label.red }}, {{ default_scheme.settings.button_label.green }}, {{ default_scheme.settings.button_label.blue }};
      --color-button-label-hex: {{ default_scheme.settings.button_label }};
      --color-secondary-button-label: {{ default_scheme.settings.secondary_button_label.red }}, {{ default_scheme.settings.secondary_button_label.green }}, {{ default_scheme.settings.secondary_button_label.blue }};
      --color-secondary-button-label-hex: {{ default_scheme.settings.secondary_button_label }};
      --color-shadow: {{ default_scheme.settings.shadow.red }}, {{ default_scheme.settings.shadow.green }}, {{ default_scheme.settings.shadow.blue }};

      /* Backward-compatible aliases */
      --color-foreground: rgb({{ default_scheme.settings.text.red }}, {{ default_scheme.settings.text.green }}, {{ default_scheme.settings.text.blue }});
      --color-accent-1: {{ default_scheme.settings.button }};
      --color-solid-button-label: {{ default_scheme.settings.button_label }};
      --color-outline-button: {{ default_scheme.settings.secondary_button_label }};

      color: rgb(var(--color-text));
      background-color: rgb(var(--color-background));
    }
  {% endif %}
{% endstyle %}


